# ─────────────────────────────────────────────────────────────
# IRH CORE — environment configuration
# Copy to `.env` and fill in. Never commit the real file.
# ─────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────
NODE_ENV=development
# Public URL of this deployment (used for OAuth2 redirects + cookies)
APP_ORIGIN=http://localhost:3000
# Public URL of the REST API (the dashboard proxies through Next.js,
# but the bot and direct clients use this)
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────
# Production (PostgreSQL). Docker compose provides this value.
DATABASE_URL=postgresql://irh:irh@localhost:5432/irh_core?schema=public
# Local SQLite fallback (used automatically by `npm run db:push` when
# DATABASE_URL is missing) is: file:./irh-core.db

# ── Redis / BullMQ (optional in single-node deployments) ────
# When set, BullMQ drives scheduled jobs and the API/bot share workers.
# When unset, IRH CORE uses its persistent database scheduler instead.
REDIS_URL=redis://localhost:6379

# ── Discord application ─────────────────────────────────────
# https://discord.com/developers/applications → your app → Bot / OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Optional: register slash commands only in this guild while developing
DISCORD_DEV_GUILD_ID=

# ── Sessions & crypto ───────────────────────────────────────
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# 32-byte hex key used to encrypt IntegrationCredentials at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Feature integrations (all optional) ─────────────────────
# YouTube Data API key enables YouTube feed polling (RSS fallback works without it)
YOUTUBE_API_KEY=
# Twitch app credentials enable Twitch live notifications
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Optional: demo/local bootstrap ──────────────────────────
# Comma separated Discord user IDs allowed to access every guild in the
# dashboard and use owner-only bot commands.
BOT_OWNER_IDS=
