{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irh-core",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-11-06",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "IrhCoreContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "IRH_CONTAINER",
        "class_name": "IrhCoreContainer"
      }
    ]
  },
  "exports": {
    "IrhCoreContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
